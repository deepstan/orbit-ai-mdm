digraph today {
  compound=true; rankdir=TB; nodesep=0.35; ranksep=0.55; fontname="Helvetica"; fontsize=22; labelloc=t;
  label=<<B>MDM platform: what is IN THE APPLICATION today</B><BR/><FONT POINT-SIZE="13">updated 2026-10-14  |  one decision logic, three engines  |  the one-engine kernel (next page) is a prototype and has not replaced them</FONT>>;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.16,0.09"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_src { label="Sources"; style="rounded,filled"; fillcolor="#fafafa"; color="#999999"; fontsize=13;
    csv [label="CSV / JSON file import\n(the working connector)", fillcolor="#d9f2d9", color="#2e7d32"];
    sf  [label="Salesforce / Shopify\n(scaffolds only)", fillcolor="#eeeeee", color="#777777", style="rounded,filled,dashed"];
  }
  subgraph cluster_api { label="API and access (FastAPI)"; style="rounded,filled"; fillcolor="#fafafa"; color="#999999"; fontsize=13;
    api [label="REST API  /v1/{domain}/...\nauthentication required by default (MDM_DEV_MODE opens it)\nroles: tenant_admin, domain_admin, data_steward, api_consumer\ndomain-scoped keys; decisions signed with the key's name\nrequest size limits and a rate limit", fillcolor="#d9f2d9", color="#2e7d32"];
    ui  [label="Stewardship console\nreview queue (paged), entity list,\naudit page, unmerge", fillcolor="#d9f2d9", color="#2e7d32"];
  }
  subgraph cluster_eng { label="THREE matching engines (same decisions, three drivers)"; style="rounded,filled"; fillcolor="#fffdf3"; color="#b26a00"; fontsize=13;
    reg  [label="Regular engine\none record at a time\n(real time)", fillcolor="#d9f2d9", color="#2e7d32"];
    bulk [label="Bulk engine\nset-based, parallel workers,\nscratch SQLite files in a temp folder", fillcolor="#d9f2d9", color="#2e7d32"];
    delta[label="Onboarding and delta\na new source / changed records\n(set-based)", fillcolor="#d9f2d9", color="#2e7d32"];
  }
  subgraph cluster_pipe { label="The pipeline every engine uses"; style="rounded,filled"; fillcolor="#fafafa"; color="#999999"; fontsize=13;
    std  [label="Standardizer\nper-domain; nicknames mapped to one name", fillcolor="#d9f2d9", color="#2e7d32"];
    blk  [label="Blocking keys + bucket caps", fillcolor="#d9f2d9", color="#2e7d32"];
    scr  [label="Scorer\ndeterministic identifiers + fuzzy similarity\n+ mismatch penalties (given names: line 0.75)\nsimilarity and embedding caches (bounded)", fillcolor="#d9f2d9", color="#2e7d32"];
    lrn  [label="Learned scorer (policy B)\npromotes review pairs; 10% audited;\nautomatic rollback", fillcolor="#d9f2d9", color="#2e7d32"];
    llm  [label="LLM adjudication\n(optional; off in bulk)", fillcolor="#d9f2d9", color="#2e7d32"];
    sep  [label="Separations\n(an unmerge is never re-merged,\nin every engine)", fillcolor="#d9f2d9", color="#2e7d32"];
    surv [label="Survivorship (per domain)\n-> the golden record", fillcolor="#d9f2d9", color="#2e7d32"];
  }
  subgraph cluster_gov { label="Governance"; style="rounded,filled"; fillcolor="#fafafa"; color="#999999"; fontsize=13;
    alog [label="Hash-chained audit log", fillcolor="#d9f2d9", color="#2e7d32"];
    aud  [label="Merge audits (sampling)\n+ rollback", fillcolor="#d9f2d9", color="#2e7d32"];
    lin  [label="Lineage of golden values", fillcolor="#d9f2d9", color="#2e7d32"];
    ten  [label="Tenant isolation\nevery query filters by tenant (48 of 48 removals caught by tests);\nPostgres row-level security is a second layer", fillcolor="#d9f2d9", color="#2e7d32"];
  }
  subgraph cluster_store { label="Storage layer"; style="rounded,filled"; fillcolor="#fafafa"; color="#999999"; fontsize=13;
    store[label="Store interface (98 methods)\nSqliteStore | PostgresStore\n(held to one interface by tests; one named exception)", fillcolor="#d9f2d9", color="#2e7d32"];
    dial [label="Dialect  (app/sql_dialect.py)\nschema text, placeholders, helpers;\nthe SQL sent is pinned by tests", fillcolor="#d9f2d9", color="#2e7d32"];
    mig  [label="Migrations 1 to 16\n(append-only, checksummed)", fillcolor="#d9f2d9", color="#2e7d32"];
    sq   [shape=cylinder, label="SQLite\ndevelopment, tests,\nsmall installs", fillcolor="#d9f2d9", color="#2e7d32"];
    pg   [shape=cylinder, label="PostgreSQL\nproduction: complete in code\nbut NEVER RUN on a server", fillcolor="#fff0cc", color="#b26a00"];
  }
  csv -> api; sf -> api [style=dashed];
  ui -> api [dir=both];
  api -> reg [lhead=cluster_eng]; 
  reg -> std [ltail=cluster_eng, lhead=cluster_pipe];
  std -> blk -> scr -> surv;
  scr -> lrn [dir=both]; scr -> llm [style=dashed];
  sep -> scr [style=dotted, constraint=false];
  surv -> store [lhead=cluster_store];
  alog -> store [dir=none, style=dotted, constraint=false]; aud -> store [dir=none, style=dotted, constraint=false];
  lin -> surv [dir=back, style=dotted, constraint=false]; ten -> store [dir=none, style=dotted];
  store -> dial; dial -> sq; dial -> pg; mig -> store [constraint=false];

  subgraph cluster_leg { label="Legend"; style="rounded"; color="#999999"; fontsize=12; rank=sink;
    l1 [label="built and tested (on SQLite)", fillcolor="#d9f2d9", color="#2e7d32", fontsize=10];
    l2 [label="built; never run on a PostgreSQL server", fillcolor="#fff0cc", color="#b26a00", fontsize=10];
    l3 [label="scaffold only", fillcolor="#eeeeee", color="#777777", style="rounded,filled,dashed", fontsize=10];
    l1 -> l2 -> l3 [style=invis, minlen=1];
  }
}
